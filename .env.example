# ---------------------------------------------------------------------------
# Seir — environment configuration
# Copy to .env and adjust for your machine. Never commit .env.
# ---------------------------------------------------------------------------

# Runtime
ENVIRONMENT=development          # development | test | staging | production
DEBUG=false

# PostgreSQL (docker compose service "db")
POSTGRES_USER=seir
POSTGRES_PASSWORD=seir_dev_password
POSTGRES_DB=seir
# Database and Redis are only reachable on the compose network. Use
# `docker compose exec db psql ...` for administration.

# Redis (docker compose service "redis")

# Secrets — generate with: openssl rand -hex 48
JWT_SECRET_KEY=dev-only-change-me-before-deploying-please

# Networking / public URLs
BACKEND_PORT=8000
FRONTEND_PORT=3000
GATEWAY_PORT=8080
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The browser uses a same-origin path; Next proxies it to the backend.
NEXT_PUBLIC_API_URL=/api/v1
INTERNAL_API_URL=http://backend:8000/api/v1
# Comma-separated origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
ALLOWED_HOSTS=*

# Demo data and operations
SEED_ON_STARTUP=true
OTP_DEBUG=true
RATE_LIMIT_ENABLED=true
WEB_CONCURRENCY=1

# AI provider: openai | openai_compatible | anthropic | gemini | none
# "none" keeps the deterministic local planner active (no external calls).
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
